  - id: wake
    speaker: "\u5C0F\u5305"
    text: "\u8FD9\u91CC\u662F\u54EA\u91CC\uFF1F\u9664\u4E86\u9ED1\u6697\uFF0C\u4EC0\u4E48\u90FD\u770B\u4E0D\u89C1\u3002"
