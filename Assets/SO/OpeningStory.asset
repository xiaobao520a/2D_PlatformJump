  - id: world
    speaker: "\u5FAE\u5149"
    text: "\u8FD9\u91CC\u662F\u4E16\u754C\u7684\u80CC\u9762\u3002\u5149\u88AB\u51FB\u788E\u4EE5\u540E\uFF0C\u65F6\u95F4\u4FBF\u505C\u5728\u4E86\u8FD9\u4E00\u5C42\u3002"
    next: shards
    choices: []
  - id: shards
    speaker: "\u5C0F\u5305"
    text: "\u90A3\u4E9B\u6563\u843D\u5728\u9AD8\u5904\u7684\u5149\u2026\u2026\u5C31\u662F\u5B9D\u77F3\u5417\uFF1F"
    next: guide
    choices: []
  - id: guide
    speaker: "\u5FAE\u5149"
    text: "\u6BCF\u4E00\u679A\u788E\u7247\u90FD\u8BB0\u5F97\u4E16\u754C\u539F\u672C\u7684\u6A21\u6837\u3002\u5E26\u56DE\u8DB3\u591F\u7684\u5149\uFF0C\u524D\u65B9\u7684\u8DEF\u624D\u4F1A\u91CD\u65B0\u51FA\u73B0\u3002"
    next: danger
    choices: []
  - id: danger
    speaker: "\u5C0F\u5305"
    text: "\u53EF\u8DEF\u4E0A\u8FD8\u6709\u90A3\u4E9B\u602A\u7269\u3002"
    next: courage
    choices: []
  - id: courage
    speaker: "\u5FAE\u5149"
    text: "\u5B83\u4EEC\u7531\u9057\u843D\u7684\u6050\u60E7\u51DD\u6210\u3002\u522B\u88AB\u5B83\u4EEC\u5413\u4F4F\uFF0C\u62AC\u8D77\u4F60\u7684\u6B66\u5668\u3002"
